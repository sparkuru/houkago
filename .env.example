# One Baidu Open Platform application per Houkago deployment.
HOUKAGO_BAIDU_CLIENT_ID=
HOUKAGO_BAIDU_CLIENT_SECRET=
HOUKAGO_BAIDU_REDIRECT_URI=http://localhost:3000/baidu/oauth/callback

# Base64-encoded 32-byte AES key. Required only for server-saved mode.
HOUKAGO_CREDENTIAL_KEY=
HOUKAGO_CREDENTIAL_KEY_VERSION=1

# Optional comma-separated normalized usernames granted site-wide Komon access
# after those accounts already exist. Never infer this role from registration order.
HOUKAGO_KOMON_USERNAMES=

# Docker development image; build explicitly with ./preview.sh build.
DX_IMAGE=houkago-dev:playwright
# Trusted-LAN host publishing. Use 127.0.0.1 for host-only access.
DX_BIND_HOST=0.0.0.0

# Container service listeners. Keep all-interface binds for Docker publishing.
HOST=0.0.0.0
PORT=9998
PREVIEW_FRONTEND_HOST=0.0.0.0
PREVIEW_FRONTEND_PORT=9999
# Published host ports may differ from the container ports.
PREVIEW_BACKEND_PORT=9998
PREVIEW_FRONTEND_PUBLISHED_PORT=9999
# Optional explicit reachable LAN host; output marks device access unverified.
PREVIEW_LAN_HOST=
PREVIEW_READY_TIMEOUT=60

# Persistent SQLite file, relative to packages/housou; stop/down retains it.
HOUSOU_DB=houkago.db
# Empty permits development origins; set an exact frontend origin to restrict it.
HOUKAGO_CORS_ORIGIN=
