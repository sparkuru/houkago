# One Baidu Open Platform application per Houkago deployment.
HOUKAGO_BAIDU_CLIENT_ID=
HOUKAGO_BAIDU_CLIENT_SECRET=
HOUKAGO_BAIDU_REDIRECT_URI=http://localhost:3000/baidu/oauth/callback

# Base64-encoded 32-byte AES key. Required only for server-saved mode.
HOUKAGO_CREDENTIAL_KEY=
HOUKAGO_CREDENTIAL_KEY_VERSION=1

# Optional comma-separated normalized usernames granted site-wide Komon access
# after those accounts already exist. Never infer this role from registration order.
HOUKAGO_KOMON_USERNAMES=
