#!/usr/bin/env bash
set -Eeuo pipefail

readonly IMAGE="${DX_IMAGE:-houkago-dev:playwright}"

usage() {
	printf 'Usage: [DX_EXTRA_PORTS=5174,5175] ./dx <command> [args...]\n' >&2
	printf 'Run in %s with the repository mounted at /app and your uid mapped.\n' "$IMAGE" >&2
	printf 'Publish free ports 3000/5173 plus optional decimal ports 1-65535.\n' >&2
	printf 'Examples: ./dx bun run typecheck; DX_EXTRA_PORTS=5174 ./dx bun run dev:react\n' >&2
}

die() {
	printf 'dx: %s\n' "$*" >&2
	exit 1
}

ensure_image() {
	local repo_root=$1

	case "${DX_REBUILD_IMAGE:-0}" in
	0 | 1) ;;
	*) die "DX_REBUILD_IMAGE must be 0 or 1" ;;
	esac

	if [[ "${DX_REBUILD_IMAGE:-0}" == 0 ]] && docker image inspect "$IMAGE" >/dev/null 2>&1; then
		return 0
	fi

	[[ -f "${repo_root}/Dockerfile.dev" ]] || die "missing development image definition: ${repo_root}/Dockerfile.dev"
	printf 'dx: building %s from Dockerfile.dev\n' "$IMAGE" >&2
	docker build --file "${repo_root}/Dockerfile.dev" --tag "$IMAGE" "$repo_root"
}

main() {
	local repo_root devhome raw_port port extra_ports
	local -a ports=(3000 5173) port_flags=() tty_flags=() requested_ports=()

	if [[ ${1:-} == --help || ${1:-} == -h ]]; then
		usage
		return 0
	fi

	extra_ports=${DX_EXTRA_PORTS:-}
	if [[ -n "$extra_ports" ]]; then
		[[ "$extra_ports" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "DX_EXTRA_PORTS must be comma-separated decimal ports (1-65535)"
		IFS=, read -r -a requested_ports <<<"$extra_ports"
		for raw_port in "${requested_ports[@]}"; do
			# Normalize before arithmetic so leading zeroes stay decimal and large inputs cannot overflow.
			port=${raw_port#"${raw_port%%[!0]*}"}
			[[ -n "$port" && ${#port} -le 5 ]] || die "DX_EXTRA_PORTS contains a port outside 1-65535"
			((10#$port <= 65535)) || die "DX_EXTRA_PORTS contains a port outside 1-65535"
			[[ " ${ports[*]} " == *" $port "* ]] || ports+=("$port")
		done
	fi

	command -v docker >/dev/null 2>&1 || die "required command not found: docker"
	command -v id >/dev/null 2>&1 || die "required command not found: id"
	command -v dirname >/dev/null 2>&1 || die "required command not found: dirname"
	command -v mkdir >/dev/null 2>&1 || die "required command not found: mkdir"
	repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
	devhome="${repo_root}/.devhome"
	mkdir -p -- "$devhome"
	ensure_image "$repo_root"

	[[ ! -t 0 ]] || tty_flags+=(-i)
	[[ ! -t 0 || ! -t 1 ]] || tty_flags+=(-t)

	# Keep verification usable alongside a server already listening on a published port.
	for port in "${ports[@]}"; do
		if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
			printf 'dx: port %s busy — skip publishing (fine for verify; dev needs it free)\n' "$port" >&2
		else
			port_flags+=(-p "${port}:${port}")
		fi
	done

	exec docker run --rm \
		"${tty_flags[@]}" \
		--user "$(id -u):$(id -g)" \
		-e HOME=/app/.devhome \
		-v "${repo_root}:/app" \
		-w /app \
		"${port_flags[@]}" \
		"$IMAGE" "$@"
}

main "$@"
